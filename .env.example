# Supabase Cloud Database & Auth Configuration
# Lấy thông tin này tại: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side Gemini API Key cho AI Practice Coach & CFOP Tutor (KHÔNG dùng NEXT_PUBLIC_)
GEMINI_API_KEY=your-gemini-api-key

# Cloudflare R2 Private Object Storage (Server-side only — cho video & bản sao lưu riêng tư)
# Bucket phải đặt ở chế độ Private (không bật Public R2.dev URL).
# Cấu hình CORS trên R2 cho phép PUT/GET từ domain web/PWA của bạn.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=ruktimer-private
# Đặt R2_MOCK=1 để dùng kho tệp giả lập cục bộ (.data/r2-mock) khi phát triển/test không có khóa R2
R2_MOCK=
